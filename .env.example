# Frontend public variables. Restrict browser keys and never put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_MAPS_API_KEY=

# Backend-only variables; store real values in the server environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_SERVER_KEY=
IMD_API_CREDENTIALS=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
GEMINI_API_KEY=

# Application mode: demo or live. Live mode must require verified configured sources.
RIDGEWATCH_MODE=demo
LOG_LEVEL=INFO
