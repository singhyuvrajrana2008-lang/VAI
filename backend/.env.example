# Copy to backend/.env (ignored by Git). Server-only values. Never expose the
# service-role key to the browser or commit a filled-in copy of this file.

# demo serves deterministic synthetic fixtures, always labelled is_demo=true.
# live serves only verified connectors (none exist yet), so data views report
# unavailable rather than inventing values.
RIDGEWATCH_MODE=demo
RIDGEWATCH_ENVIRONMENT=local

# Comma-separated browser origins allowed to call the API. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Provider request timeout (seconds) used by connector adapters.
RIDGEWATCH_PROVIDER_TIMEOUT_SECONDS=5

# Optional, presence only. Persistence/auth wiring is not verified by this build.
# A configured service-role key does NOT enable database writes yet; health
# reports "configured_not_connected" instead of claiming persistence works.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
