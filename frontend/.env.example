# Copy to frontend/.env.local (ignored by Git). All values here are PUBLIC and
# end up in the browser bundle. Never place a service-role key in this file.

# API root including /api/v1. Leave as /api/v1 to use the Vite dev proxy
# (recommended for local previews). Set an absolute URL only for split hosting.
VITE_API_BASE_URL=/api/v1

# Optional. Google Maps JavaScript API browser key, restricted by allowed web
# referrer and by API. When empty, a labelled schematic fallback is shown.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Supabase project URL and the browser-safe anon/publishable key.
# When empty, the app runs in demo mode and the auth pages explain configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
